# ResearchAI environment configuration
# Replace the placeholder values with your real keys and preferred defaults.

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Configure one or more providers. The system uses all available providers
# with load balancing and automatic failover on rate limits.
#
# Each provider supports:
#   *_API_KEYS     - Comma-separated API keys (multiple for load balancing)
#   *_MODELS       - Model name(s) to use
#   *_BACKUP_MODEL - Fallback model if primary fails
#   *_TASKS        - Task types: all, none, or comma-separated list
#   *_LOG          - Log requests (1=on, 0=off)
#
# Task types: summarization, subtopic, validation, report, recommendations, research

# --- OpenRouter ---
OPENROUTER_API_KEYS=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api
OPENROUTER_MODELS=stepfun/step-3.5-flash:free
OPENROUTER_BACKUP_MODEL=arcee-ai/trinity-large-preview:free
OPENROUTER_TASKS=all
OPENROUTER_LOG=1

# --- Groq (fast inference) ---
GROQ_API_KEYS=your_groq_api_key_here
GROQ_MODELS=moonshotai/kimi-k2-instruct-0905
GROQ_BACKUP_MODEL=llama-3.3-70b-versatile
GROQ_TASKS=report
GROQ_LOG=1

# --- Google AI Studio ---
# GOOGLE_AI_KEYS=your_google_ai_key_here
# GOOGLE_AI_MODELS=gemini-2.0-flash-exp
# GOOGLE_AI_BACKUP_MODEL=gemini-1.5-flash
# GOOGLE_AI_TASKS=none
# GOOGLE_AI_LOG=1

# --- Ollama (local models - uses base URLs instead of API keys) ---
# OLLAMA_BASE_URLS=http://localhost:11434
# OLLAMA_MODELS=llama3.1:70b
# OLLAMA_BACKUP_MODEL=llama3.1:8b
# OLLAMA_TASKS=none
# OLLAMA_LOG=1

# --- OpenAI (direct API) ---
# OPENAI_API_KEYS=your_openai_api_key_here
# OPENAI_MODELS=gpt-4o-mini
# OPENAI_BACKUP_MODEL=gpt-3.5-turbo
# OPENAI_TASKS=none
# OPENAI_LOG=1

# --- Provider fallback order (when a provider hits rate limits) ---
LLM_FALLBACK_CHAIN=openrouter,groq,google_ai,openai,ollama

# Runtime directory for transient files (db, cache, artifacts)
# Default: $TMPDIR/researchai (or /tmp/researchai on Linux)
# Set to a custom path if you want to preserve runtime data between runs
# RUNTIME_DIR=/tmp/researchai

# Auto-cleanup: delete runtime files (db, cache) after report is generated (1=on, 0=off)
# Report output (OUTPUT_PATH) is preserved regardless of this setting
AUTO_CLEANUP=1

# Datastore path (relative paths go inside RUNTIME_DIR)
DB_PATH=state.db
OUTPUT_PATH=research_report.md

# Orchestrator defaults
# Lower depth/children to avoid large branching and memory pressure
MAX_DEPTH=3
MAX_CHILDREN=4
CONCURRENCY=30
# Maximum simultaneous tasks/processes/API calls system-wide (1 = fully sequential execution)
# When set to 1, ensures only ONE operation happens at a time (one agent, one HTTP call, one LLM request)
# Scaling depth/layers increases only time, not memory or CPU usage
MAX_CONCURRENT_TASKS=35
# OpenRouter web plugin requires paid credits. Use 'http' for free web search.
# CONNECTOR=openrouter_web  # Requires credits
CONNECTOR=http # Free web search (Bing/Wikipedia/arXiv)
SOURCE_COUNT=7
# Minimum delay between web searches to avoid rate limits (0 to disable)
WEB_SEARCH_DELAY_SEC=0.7

# Runtime progress logs
PROGRESS_LOG=1
PROGRESS_VERBOSE_TASKS=1
PROGRESS_INTERVAL_SEC=5

# Output length configuration
# Summary word count for the top-level summary section (default: 200)
SUMMARY_WORD_COUNT=600
# Report body word count range (default: 500-1000)
REPORT_MIN_WORDS=2000
REPORT_MAX_WORDS=8000

# Progress bar display mode: "tui" for sticky bottom bar, "scroll" for standard scrolling logs
PROGRESS_DISPLAY_MODE=tui
